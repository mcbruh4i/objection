# Use an absolute path when you want a database outside the backend directory.
DATABASE_PATH=

# The backend is intended for trusted LAN development. For Expo Web on another
# device, add that device's exact http://LAN-IP:PORT origin here.
# Comma-separated trusted development origins. Localhost origins are also
# accepted by the development CORS regex so Expo can choose an available port.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# /demo/reset is mounted only when both values opt into development reset.
# Keep it disabled by default and restart the API after changing either value.
APP_ENV=development
DEMO_RESET_ENABLED=false

# Courtroom model adapter. Leave all four blank to run the deterministic
# fallback path. If any model configuration is supplied, a failed Judge call
# resolves the case as a 1x absentia ruling; never commit a real key.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_PROSECUTOR=
LLM_MODEL_JUDGE=
